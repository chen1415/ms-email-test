<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title === 'undefined' ? 'Outlook Graph PoC' : title %></title>
  <style>
    :root { font-family: ui-sans-serif, system-ui, sans-serif; color: #111; }
    body { margin: 24px auto; max-width: 1100px; }
    a { color: #0b57d0; }
    header.top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 16px; }
    .muted { color: #666; font-size: 13px; }
    .stats { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
    .chip { background: #f3f4f6; padding: 6px 10px; border-radius: 6px; font-size: 13px; }
    table { border-collapse: collapse; width: 100%; font-size: 14px; }
    th, td { border-bottom: 1px solid #e5e7eb; text-align: left; padding: 8px; vertical-align: top; }
    th { font-size: 12px; text-transform: uppercase; color: #555; }
    .actions { display: flex; flex-wrap: wrap; gap: 6px; }
    button, .btn { background: #111; color: #fff; border: 0; padding: 6px 10px; border-radius: 4px; cursor: pointer; font-size: 13px; text-decoration: none; display: inline-block; }
    .btn.secondary { background: #e5e7eb; color: #111; }
    .warn { background: #fff4e5; padding: 10px 12px; border-radius: 6px; }
    dl { display: grid; grid-template-columns: 180px 1fr; gap: 6px 12px; }
    dt { color: #555; }
    pre { white-space: pre-wrap; word-break: break-all; }
  </style>
</head>
<body>
  <header class="top">
    <div>
      <h1 style="margin:0;font-size:22px;"><a href="/" style="color:inherit;text-decoration:none;">Outlook Graph PoC</a></h1>
      <div class="muted">CSV 账本 · 一个 Microsoft App · 10 个 Outlook.com</div>
    </div>
  </header>
