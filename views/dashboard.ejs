<%- include('partials/head', { title: 'Outlook Graph PoC' }) %>

<% if (!msConfigured) { %>
  <p class="warn">还没有配置 Microsoft 客户端。把 Client ID / Secret 写入 .env 后再添加 Outlook。</p>
<% } %>

<div class="actions" style="margin-bottom:14px;">
  <a class="btn" href="/auth/microsoft">添加 Outlook</a>
</div>

<div class="panel">
  <div class="muted" style="margin-bottom:10px;">调度器</div>
  <div class="scheduler" id="scheduler">
    <div class="kv"><b>状态</b><span id="sch-phase"><%= scheduler.phaseLabel %></span></div>
    <div class="kv"><b>本轮</b><span id="sch-cycle"><%= scheduler.cycleIndex %> / <%= scheduler.cycleTotal %></span></div>
    <div class="kv"><b>配额</b><span id="sch-quota"><%= scheduler.tokensUsedThisMinute %> / <%= scheduler.tokensMax %></span></div>
    <div class="kv"><b>预计一轮</b><span id="sch-eta">~<%= scheduler.estimatedCycleMin %> min</span></div>
    <div class="kv"><b>最近 429</b><span id="sch-429"><%= scheduler.last429At %></span></div>
  </div>
</div>

<div class="stats">
  <span class="chip">Accounts <%= stats.accounts %></span>
  <span class="chip ok">Running <%= stats.running %></span>
  <span class="chip warn">Reauth <%= stats.reauth %></span>
  <span class="chip">Disabled <%= stats.disabled %></span>
  <span class="chip">Messages <%= stats.messages %></span>
  <span class="chip">EML <%= stats.eml %></span>
  <span class="chip">Forward <%= enableForward ? 'on' : 'off' %></span>
  <span class="chip">Graph 429 <%= stats.graph429 %></span>
</div>

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Status</th>
      <th>Status time</th>
      <th>Last sync</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if (accounts.length === 0) { %>
      <tr><td colspan="5" class="muted">还没有账号。点「添加 Outlook」，在微软页面登录。</td></tr>
    <% } %>
    <% accounts.forEach(function (account) { %>
      <tr>
        <td><a href="/account/<%= account.id %>"><%= account.email %></a></td>
        <td><span class="pill <%= account.status === 'Running' ? 'running' : (account.status === 'ReauthRequired' ? 'reauth' : '') %>"><%= account.status %></span></td>
        <td><%= formatTime(account.status_changed_at) %></td>
        <td><%= formatTime(account.last_sync_at) %></td>
        <td class="actions">
          <a class="btn secondary" href="/account/<%= account.id %>">查看</a>
          <% if (account.status === 'ReauthRequired') { %>
            <a class="btn" href="/auth/microsoft">Re-auth</a>
          <% } %>
          <% if (account.status !== 'Disabled') { %>
            <form method="post" action="/account/<%= account.id %>/disable">
              <button type="submit" class="secondary">Disable</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<script>
  async function refreshScheduler() {
    try {
      const res = await fetch('/api/scheduler');
      if (!res.ok) return;
      const s = await res.json();
      document.getElementById('sch-phase').textContent = s.phaseLabel;
      document.getElementById('sch-cycle').textContent = s.cycleIndex + ' / ' + s.cycleTotal;
      document.getElementById('sch-quota').textContent = s.tokensUsedThisMinute + ' / ' + s.tokensMax;
      document.getElementById('sch-eta').textContent = '~' + s.estimatedCycleMin + ' min';
      document.getElementById('sch-429').textContent = s.last429At;
    } catch (e) {}
  }
  setInterval(refreshScheduler, 2000);
</script>
</body>
</html>
